root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ts,tsx,js,mjs,cjs,json,jsonc,yml,yaml}]
indent_size = 2

[*.slurp]
indent_size = 2

[*.md]
# Markdown gives meaning to trailing whitespace (two spaces is a hard break).
trim_trailing_whitespace = false
indent_size = 2

[Makefile]
indent_style = tab
