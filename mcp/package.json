{
  "name": "@bytesell/slurp-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for Slurp: validate, render, inspect and look up .slurp templates in-process, so a coding agent can close its own correction loop.",
  "license": "MIT",
  "author": "ByteSell LLC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bytesell/slurp.git",
    "directory": "mcp"
  },
  "bugs": {
    "url": "https://github.com/bytesell/slurp/issues"
  },
  "homepage": "https://github.com/bytesell/slurp#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "slurp",
    "mcp",
    "model-context-protocol",
    "templating",
    "agent"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "slurp-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && node scripts/generate-llms-full.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/bin.js",
    "build:llms": "node scripts/generate-llms-full.mjs",
    "check:llms": "node scripts/generate-llms-full.mjs --check"
  },
  "dependencies": {
    "@bytesell/slurp-compiler-wasm": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
