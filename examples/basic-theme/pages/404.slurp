---
using "@components/ProductCard"
using "@components/SkeletonCard"
---

{* Only the BLOCK form of {layout} can fill the layout's head slot. With the
   element form, <layout src="...">, the {head} children stay in the body. *}
{layout "@layouts/base"}
  {* base.slurp already emits <title> and the meta description from `seo`, so
     the head slot carries only what the layout does not. A second <title>
     would simply be ignored by the browser. *}
  {head}
    <meta name="robots" content="noindex, follow" />
  {/head}

  <div class="not-found">

    {* Large decorative 404 *}
    <div class="not-found__code" aria-hidden="true">404</div>

    <h1 class="not-found__heading">Page not found</h1>
    <p class="not-found__sub">
      Sorry, we couldn't find the page you're looking for. It may have moved,
      been renamed, or no longer exists.
    </p>

    {* Helpful navigation links *}
    <nav class="not-found__links" aria-label="Helpful links">
      <a href="/" class="btn btn--primary">Go Home</a>
      <a href="/collections/all" class="btn btn--ghost">Browse Products</a>
      <a href="/contact" class="btn btn--ghost">Contact Support</a>
    </nav>

    {* Search hint *}
    <div class="not-found__search">
      <p>Looking for something specific?</p>
      <form action="/search" class="search-form" role="search">
        <input
          class="search-input"
          type="search"
          name="q"
          placeholder="Search products..."
          aria-label="Search products"
        />
        <button class="btn btn--primary" type="submit">Search</button>
      </form>
    </div>

    {* Suggested products *}
    <section class="not-found__suggestions">
      <h2>You might like</h2>
      {* Branch order inside {fetch} is fixed: body, {loading}, {error}, {empty}.
         None of the three branch markers takes a closing tag. *}
      {fetch suggestions: Product[] from "/api/products/featured" cache(600)}
        <div class="product-grid">
          {each product in suggestions | limit(4)}
            <ProductCard product={product} />
          {/each}
        </div>
      {loading}
        <div class="product-grid">
          {repeat 4}
            <SkeletonCard />
          {/repeat}
        </div>
      {error}
        {* Silently fail - suggestions are non-critical *}
      {empty}
        {* Nothing to suggest, so show nothing *}
      {/fetch}
    </section>

  </div>

{/layout}

<style>
.not-found {
  max-width: 900px;
  margin: 0 auto;
  padding: 4rem 1.5rem 5rem;
  text-align: center;
}
.not-found__code {
  font-size: clamp(6rem, 18vw, 12rem);
  font-weight: 900;
  color: #f3f4f6;
  line-height: 1;
  margin-bottom: -1rem;
  user-select: none;
}
.not-found__heading {
  font-size: clamp(1.5rem, 4vw, 2.25rem);
  font-weight: 800;
  margin-bottom: 0.75rem;
}
.not-found__sub {
  color: #6b7280;
  font-size: 1.0625rem;
  max-width: 480px;
  margin: 0 auto 2rem;
  line-height: 1.6;
}
.not-found__links {
  display: flex;
  gap: 0.75rem;
  justify-content: center;
  flex-wrap: wrap;
  margin-bottom: 2.5rem;
}
.not-found__search {
  background: #f9fafb;
  border: 1px solid #e5e7eb;
  border-radius: 0.75rem;
  padding: 1.5rem;
  max-width: 480px;
  margin: 0 auto 3rem;
}
.not-found__search p {
  color: #374151;
  font-weight: 500;
  margin-bottom: 0.75rem;
}
.search-form {
  display: flex;
  gap: 0.5rem;
}
.search-input {
  flex: 1;
  border: 1px solid #d1d5db;
  border-radius: 0.375rem;
  padding: 0.5rem 0.875rem;
  font-size: 0.9375rem;
}
.not-found__suggestions h2 {
  font-size: 1.25rem;
  font-weight: 700;
  margin-bottom: 1.25rem;
}
.product-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 1.25rem;
  text-align: left;
}
</style>
