---
using "@components/ProductCard"
using "@components/Badge"
using "@components/SkeletonCard"

type Collection {
  title: string
  description: string
  image: string
  slug: string
}
---

{layout "@layouts/base"}

  {head}
    {* The base layout already emits <title> and the meta description from the
       `seo` context, so a page contributes only what the layout does not. *}
    <link rel="canonical" href="/collections/${ params.slug }" />
  {/head}

  {fetch collection: Collection from getCollection(params.slug) cache(300)}

    <div class="collection-hero">
      {if collection.image}
        <Image
          src={collection.image}
          alt={collection.title}
          width={1280}
          height={400}
          priority
        />
      {/if}
      <div class="collection-hero__text">
        <h1>${ collection.title }</h1>
        {if collection.description}
          <p>${ collection.description }</p>
        {/if}
      </div>
    </div>

  {loading}
    <div class="collection-hero collection-hero--skeleton">
      <div class="skeleton skeleton--banner"></div>
    </div>

  {error}
    <div class="error-page section__inner" role="alert">
      <h1>Collection not found</h1>
      <p>${ error.status == 404 ? "This collection doesn't exist." : error.message }</p>
      <a href="/" class="btn btn--primary">Go Home</a>
    </div>

  {/fetch}

  {* --- Product grid with pagination --- *}
  <section class="collection-body section">
    <div class="section__inner">

      {* Client state for the toolbar. A {$let} seeds the browser runtime only:
         it creates no template binding, so the server renders the unfiltered,
         default-sorted grid and the runtime takes over from there. *}
      {$let sortBy = "price"}
      {$let filterStatus = "all"}

      {* Toolbar: filters + sort *}
      <div class="collection-toolbar">
        <div class="collection-toolbar__filters">
          <span class="toolbar-label">Filter:</span>
          <button
            class={"filter-btn", "filter-btn--active": filterStatus == "all"}
            on:click="filterStatus = 'all'"
          >All</button>
          <button
            class={"filter-btn", "filter-btn--active": filterStatus == "available"}
            on:click="filterStatus = 'available'"
          >In Stock</button>
          <button
            class={"filter-btn", "filter-btn--active": filterStatus == "sale"}
            on:click="filterStatus = 'sale'"
          >Sale</button>
        </div>

        <div class="collection-toolbar__sort">
          <label class="toolbar-label" for="sort-select">Sort:</label>
          <select id="sort-select" class="sort-select" on:change="sortBy = $event.target.value">
            <option value="price">Price: Low to High</option>
            <option value="-price">Price: High to Low</option>
            <option value="-createdAt">Newest First</option>
            <option value="title">A - Z</option>
          </select>
        </div>
      </div>

      {* Paginated products *}
      {fetch products: Product[] from getProducts(params.slug, filterStatus, sortBy) paginate(12)}

        {* Results count *}
        <p class="results-count">
          Showing page ${ products.page } of ${ products.totalPages }
          (${ products.total } products)
        </p>

        <div class="product-grid">
          {each product in products}
            <ProductCard product={product} />
          {empty}
            <div class="empty-collection">
              <h2>No products found</h2>
              <p>Try a different filter or browse all products.</p>
              <button class="btn btn--ghost" on:click="filterStatus = 'all'">Clear Filters</button>
            </div>
          {/each}
        </div>

        {* Pagination controls *}
        <nav class="pagination" aria-label="Product pages">
          <button
            class="btn btn--ghost"
            disabled={!products.hasPrev}
            on:click="products.prev()"
            aria-label="Previous page"
          >
            &larr; Previous
          </button>

          <div class="pagination__pages">
            {* Page numbers - show up to 7 *}
            {each page in products.pages | limit(7)}
              <button
                class={"pagination__page", "pagination__page--active": page == products.page}
                on:click="products.goTo(page)"
                aria-current="${ page == products.page ? 'page' : 'false' }"
                aria-label={`Page ${page}`}
              >
                ${ page }
              </button>
            {/each}
          </div>

          <button
            class="btn btn--ghost"
            disabled={!products.hasNext}
            on:click="products.next()"
            aria-label="Next page"
          >
            Next &rarr;
          </button>
        </nav>

      {loading}
        <div class="product-grid">
          {repeat 12}
            <SkeletonCard />
          {/repeat}
        </div>

      {error}
        <div class="error-banner" role="alert">
          <p>Could not load products: ${ error.message }</p>
          <a href="/collections/all" class="btn btn--ghost">Try again</a>
        </div>

      {/fetch}
    </div>
  </section>

  {if env.dev}
    {debug params}
  {/if}

{/layout}

<style>
/* --- Hero banner --- */
.collection-hero {
  position: relative;
  overflow: hidden;
  min-height: 220px;
  background: #f3f4f6;
}
.collection-hero img {
  width: 100%;
  height: 260px;
  object-fit: cover;
  display: block;
}
.collection-hero__text {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 2rem 3rem;
  background: linear-gradient(90deg, rgba(0,0,0,0.55) 0%, transparent 70%);
  color: #fff;
}
.collection-hero__text h1 { font-size: 2rem; font-weight: 800; margin: 0 0 0.5rem; }
.collection-hero__text p  { font-size: 1rem; opacity: 0.85; margin: 0; }
.collection-hero--skeleton .skeleton--banner {
  width: 100%;
  height: 260px;
  border-radius: 0;
}

/* --- Toolbar --- */
.section { padding: 2.5rem 0; }
.section__inner { max-width: 1280px; margin: 0 auto; padding: 0 1.5rem; }
.collection-toolbar {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  flex-wrap: wrap;
  margin-bottom: 1.5rem;
}
.toolbar-label {
  font-size: 0.875rem;
  font-weight: 600;
  color: #374151;
}
.collection-toolbar__filters {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}
.filter-btn {
  border: 1px solid #d1d5db;
  background: #fff;
  border-radius: 9999px;
  padding: 0.3rem 0.875rem;
  font-size: 0.875rem;
  cursor: pointer;
  color: #374151;
  transition: background 0.15s, border-color 0.15s;
}
.filter-btn:hover { background: #f3f4f6; }
.filter-btn--active {
  background: #111827;
  border-color: #111827;
  color: #fff;
}
.collection-toolbar__sort {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-left: auto;
}
.sort-select {
  border: 1px solid #d1d5db;
  border-radius: 0.375rem;
  padding: 0.3rem 0.6rem;
  font-size: 0.875rem;
  background: #fff;
  cursor: pointer;
}
.results-count {
  font-size: 0.875rem;
  color: #6b7280;
  margin-bottom: 1rem;
}

/* --- Grid --- */
.product-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 1.25rem;
}

/* --- Empty --- */
.empty-collection {
  grid-column: 1 / -1;
  text-align: center;
  padding: 3rem;
}
.empty-collection h2 { margin-bottom: 0.5rem; }
.empty-collection p { color: #6b7280; margin-bottom: 1.25rem; }

/* --- Pagination --- */
.pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  margin-top: 2.5rem;
  flex-wrap: wrap;
}
.pagination__pages { display: flex; gap: 0.25rem; }
.pagination__page {
  width: 2.25rem;
  height: 2.25rem;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #d1d5db;
  border-radius: 0.375rem;
  background: #fff;
  font-size: 0.875rem;
  cursor: pointer;
  color: #374151;
}
.pagination__page:hover { background: #f3f4f6; }
.pagination__page--active {
  background: #111827;
  border-color: #111827;
  color: #fff;
  font-weight: 600;
}

/* --- Errors --- */
.error-page { text-align: center; padding: 4rem 1.5rem; }
.error-banner {
  background: #fef2f2;
  border: 1px solid #fca5a5;
  border-radius: 0.75rem;
  padding: 1.25rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}
.error-banner p { color: #991b1b; margin: 0; }
</style>
