---
{* Full product page loading skeleton - no props *}
---

<div class="skeleton-product" aria-hidden="true" role="presentation">
  <div class="skeleton-product__gallery">
    <div class="skeleton skeleton--hero-image"></div>
    <div class="skeleton-product__thumbs">
      {repeat 4}
        <div class="skeleton skeleton--thumb"></div>
      {/repeat}
    </div>
  </div>

  <div class="skeleton-product__info">
    {* Title *}
    <div class="skeleton skeleton--h1"></div>
    <div class="skeleton skeleton--h1-short"></div>

    {* Badge + price *}
    <div class="skeleton-product__price-row">
      <div class="skeleton skeleton--badge"></div>
      <div class="skeleton skeleton--price-lg"></div>
      <div class="skeleton skeleton--price-compare"></div>
    </div>

    {* Description lines. The short last line is a CSS :last-child rule, not
       a loop.last test: {repeat} binds no loop variables, so loop.last is
       null in here and every line would come out the same width. *}
    <div class="skeleton-product__lines">
      {repeat 5}
        <div class="skeleton skeleton--text"></div>
      {/repeat}
    </div>

    {* Specs *}
    <div class="skeleton-product__specs">
      {repeat 3}
        <div class="skeleton-product__spec-row">
          <div class="skeleton skeleton--spec-key"></div>
          <div class="skeleton skeleton--spec-val"></div>
        </div>
      {/repeat}
    </div>

    {* Add to cart button *}
    <div class="skeleton skeleton--cta"></div>
  </div>
</div>

<style>
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50%       { opacity: 0.45; }
}
.skeleton { background: #e5e7eb; border-radius: 0.375rem; animation: pulse 1.8s ease-in-out infinite; }
.skeleton-product {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  max-width: 1100px;
  margin: 2rem auto;
  padding: 0 1.5rem;
}
.skeleton-product__gallery {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}
.skeleton--hero-image {
  width: 100%;
  aspect-ratio: 4/3;
  border-radius: 0.75rem;
}
.skeleton-product__thumbs {
  display: flex;
  gap: 0.5rem;
}
.skeleton--thumb {
  width: 72px;
  height: 72px;
  border-radius: 0.5rem;
}
.skeleton-product__info {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}
.skeleton--h1       { height: 2rem;   width: 80%; }
.skeleton--h1-short { height: 2rem;   width: 55%; }
.skeleton-product__price-row {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin: 0.25rem 0;
}
.skeleton--badge       { height: 1.25rem; width: 3.5rem; border-radius: 9999px; }
.skeleton--price-lg    { height: 1.75rem; width: 5rem; }
.skeleton--price-compare { height: 1.25rem; width: 3.5rem; }
.skeleton-product__lines {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}
.skeleton--text { height: 0.875rem; width: 100%; }
.skeleton-product__lines .skeleton--text:last-child { width: 60%; }
.skeleton-product__specs {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  margin: 0.25rem 0;
}
.skeleton-product__spec-row {
  display: flex;
  gap: 1rem;
  align-items: center;
}
.skeleton--spec-key { height: 0.75rem; width: 6rem; }
.skeleton--spec-val { height: 0.75rem; width: 8rem; }
.skeleton--cta {
  height: 3rem;
  width: 100%;
  border-radius: 0.5rem;
  margin-top: 0.5rem;
}
@media (max-width: 768px) {
  .skeleton-product { grid-template-columns: 1fr; }
}
</style>
