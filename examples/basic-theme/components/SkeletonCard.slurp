---
{* No props - pure loading skeleton *}
---

<div class="skeleton-card" aria-hidden="true" role="presentation">
  <div class="skeleton skeleton--image"></div>
  <div class="skeleton-card__body">
    <div class="skeleton skeleton--title"></div>
    <div class="skeleton skeleton--subtitle"></div>
    <div class="skeleton-card__price-row">
      <div class="skeleton skeleton--price"></div>
      <div class="skeleton skeleton--price skeleton--price-sm"></div>
    </div>
    <div class="skeleton skeleton--button"></div>
  </div>
</div>

<style>
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50%       { opacity: 0.45; }
}
.skeleton-card {
  border: 1px solid #e5e7eb;
  border-radius: 0.75rem;
  overflow: hidden;
  background: #fff;
}
.skeleton {
  background: #e5e7eb;
  border-radius: 0.375rem;
  animation: pulse 1.8s ease-in-out infinite;
}
.skeleton--image {
  width: 100%;
  aspect-ratio: 3/2;
  border-radius: 0;
}
.skeleton-card__body {
  padding: 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.625rem;
}
.skeleton--title {
  height: 1rem;
  width: 72%;
}
.skeleton--subtitle {
  height: 0.75rem;
  width: 55%;
}
.skeleton-card__price-row {
  display: flex;
  gap: 0.5rem;
  align-items: center;
}
.skeleton--price {
  height: 1rem;
  width: 3.5rem;
}
.skeleton--price-sm {
  height: 0.75rem;
  width: 2.5rem;
}
.skeleton--button {
  height: 2.5rem;
  width: 100%;
  border-radius: 0.5rem;
  margin-top: 0.25rem;
}
</style>
